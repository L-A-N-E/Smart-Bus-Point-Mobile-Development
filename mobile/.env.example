# Copie para .env e ajuste se necessário.

# Roda o app 100% com dados fixos (src/data), sem precisar do backend nem de tokens.
# Ótimo para demonstração. Use "false" para consumir a API própria (pasta /backend).
EXPO_PUBLIC_USE_MOCK=true

# Opcional: endereço da API do SBP (pasta /backend).
# Por padrão o app descobre o IP do computador que está servindo o Expo (como no Rover).
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
