{
  "name": "sbp-backend",
  "version": "1.0.0",
  "description": "API própria do S.B.P.: protege o token da SPTrans, cacheia respostas e alimenta o app mobile (paradas, linhas, rotas, status do metrô/trem e relatos)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "gtfs:import": "tsx --env-file-if-exists=.env scripts/importGtfs.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "express": "^5.2.1",
    "unzipper": "^0.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
