# Copie para .env e ajuste. Nunca comite o .env (ele tem segredos).

# Porta da API (o app mobile acessa http://<IP-do-PC>:PORT quando EXPO_PUBLIC_USE_MOCK=false)
PORT=3333

# Credenciais da API Olho Vivo da SPTrans (cadastro em https://www.sptrans.com.br/desenvolvedores/).
# O backend autentica com POST /Login/Autenticar e reaproveita o cookie de sessão.
OLHOVIVO_TOKEN=
OLHOVIVO_BASE_URL=http://api.olhovivo.sptrans.com.br/v2.1

# Chave gratuita da API do Trilhos Agora (status do metrô/trem), cadastro em
# https://api.trilhosagora.com.br/v1/openapi.json
TRILHOS_API_KEY=

# Geocodificação via OpenStreetMap Nominatim (restrita à região metropolitana de SP).
# Use "off" para rodar sem geocodificação (busca de endereço fica indisponível).
GEOCODING=on

# Grava em SQLite cada previsão/posição consultada, para medir depois a acurácia da SPTrans.
COLLECTOR=off

# Motor do planejador de rotas: "builtin" (grafo próprio, ônibus + GTFS) ou "otp" (OpenTripPlanner).
PLANNER=builtin
OTP_URL=http://localhost:8080/otp/routers/default
